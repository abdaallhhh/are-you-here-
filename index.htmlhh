<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>S Y S T E M _ M A T R I X</title>
    <style>
        /* تنسيقات الصفحة بالكامل لملء الشاشة وإخفاء القوائم */
        body { margin: 0; padding: 0; overflow: hidden; background: #000; }
        #matrix { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1; }
        
        /* إضافة طبقة شفافية سوداء لتعميق اللون الأسود */
        #matrix::after { content: ""; position: absolute; top:0; left:0; width:100%; height:100%; background: rgba(0,0,0,0.5); z-index: 2; pointer-events: none; }
    </style>
</head>
<body>

    <canvas id="matrix"></canvas>

    <script>
        // 1. إعداد الكانفاس
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');

        // اجعل الكانفاس بملء شاشة الجوال تماماً
        canvas.height = window.innerHeight;
        canvas.width = window.innerWidth;

        // 2. إعداد الحروف والأعمدة
        // مجموعة الحروف (يمكنك استخدام حروف عربية، إنجليزية، يابانية...إلخ)
        const katakana = "アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン0123456789";
        const latin = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const nums = "0123456789";
        const alphabet = katakana + latin + nums;

        const fontSize = 16;
        const columns = Math.floor(canvas.width / fontSize); // عدد الأعمدة بناءً على عرض الشاشة

        // مصفوفة لتخزين موقع الـ Y (الارتفاع) الحالي لكل عمود
        const drops = [];
        // ابدأ كل عمود من أعلى الشاشة (موقع y=1)
        for (let x = 0; x < columns; x++) {
            drops[x] = 1;
        }

        // 3. دالة الرسم الأساسية
        function draw() {
            // تأثير "الذيل" (التلاشي)
            // ارسم مستطيل أسود شفاف على كامل الكانفاس في كل إطار
            ctx.fillStyle = "rgba(0, 0, 0, 0.05)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // اجعل الحروف خضراء فسفورية
            ctx.fillStyle = "#0f0";
            ctx.font = fontSize + "px monospace";

            // ارسم الحروف في كل عمود
            for (let i = 0; i < drops.length; i++) {
                // اختر حرفاً عشوائياً من المجموعة
                const text = alphabet.charAt(Math.floor(Math.random() * alphabet.length));
                // ارسم الحرف في موقع (x*fontSize, drops[i]*fontSize)
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                // إذا وصل الحرف لأسفل الشاشة، قم بإعادة تعيينه عشوائياً للأعلى
                // لإعطاء انطباع باللانهائية وعدم التزامن
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                    drops[i] = 0;
                }

                // حرك الـ Y لأسفل للأطر القادم
                drops[i]++;
            }
        }

        // 4. تشغيل الأنيميشن
        // قم باستدعاء دالة الرسم باستمرار (ثلاً 30 مرة في الثانية)
        setInterval(draw, 33);

        // 5. التعامل مع تغيير حجم الشاشة (في حال تم تدوير الجوال)
        window.addEventListener('resize', () => {
            canvas.height = window.innerHeight;
            canvas.width = window.innerWidth;
            // يجب إعادة حساب الأعمدة وإعادة تعيين drops عند تغيير الحجم
            const newColumns = Math.floor(canvas.width / fontSize);
            for (let x = 0; x < newColumns; x++) {
                if(drops[x] === undefined) {
                    drops[x] = Math.random() * -canvas.height;
                }
            }
        });
    </script>
</body>
</html>
